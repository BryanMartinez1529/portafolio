---
// Hero.astro - Modern interactive hero with real-time typewriter code editor
---

<section id="inicio" class="relative min-h-screen pt-28 pb-16 md:pt-36 md:pb-24 flex items-center justify-center overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Personal Intro & CTAs -->
      <div class="lg:col-span-6 flex flex-col items-start space-y-6 text-left">
        
        <!-- Availability Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold tracking-wide">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          Disponible para proyectos & retos profesionales
        </div>

        <!-- Main Headline -->
        <div class="space-y-2">
          <p class="text-sm md:text-base font-mono-code text-cyan-400 tracking-wider uppercase font-semibold">
            &lt;Hola, bienvenido /&gt;
          </p>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-tight">
            Soy <span class="bg-gradient-to-r from-white via-slate-100 to-cyan-300 bg-clip-text text-transparent">Bryan Martinez</span>
          </h1>
          <div class="pt-1">
            <h2 class="text-xl sm:text-2xl md:text-3xl font-bold bg-gradient-to-r from-cyan-400 via-indigo-300 to-emerald-400 bg-clip-text text-transparent inline-block">
              Ingeniero en Sistemas — FullStack Developer
            </h2>
          </div>
        </div>

        <!-- Description -->
        <p class="text-slate-300 text-base md:text-lg leading-relaxed max-w-xl font-normal">
          Desarrollador con sólida formación en ingeniería y visión integral de producto. Especializado en crear plataformas web modernas, interfaces reactivas de alta fidelidad, arquitecturas backend resilientes y bases de datos escalables.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-2 w-full sm:w-auto">
          <a
            href="#proyectos"
            class="px-6 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:-translate-y-0.5 transition-all duration-300 flex items-center gap-2 group text-sm md:text-base"
          >
            <span>Ver Proyectos</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="/cv/CV_Bryan_Martinez.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 rounded-xl font-semibold text-slate-200 hover:text-white bg-slate-900/80 hover:bg-slate-800/90 border border-slate-700/80 hover:border-slate-500 hover:-translate-y-0.5 transition-all duration-300 flex items-center gap-2 text-sm md:text-base"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
