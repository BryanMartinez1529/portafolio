            </svg>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/bryan-martinez-04183828a/"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 hover:text-white hover:border-cyan-500/50 hover:bg-slate-800 transition-all duration-200"
            aria-label="LinkedIn de Bryan Martinez"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9h2.79v8.37H6.46v-8.37M7.86 6.32a1.63 1.63 0 1 0 0 3.26 1.63 1.63 0 0 0 0-3.26Z"/>
            </svg>
          </a>

          <!-- Mail -->
          <a
            href="mailto:bryanwladimir8@gmail.com"
            class="p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 hover:text-white hover:border-cyan-500/50 hover:bg-slate-800 transition-all duration-200"
            aria-label="Enviar correo a Bryan Martinez"
          >
            <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </a>

          <span class="text-xs text-slate-500">|</span>
          <span class="text-xs text-slate-400">Ecuador · Remoto / Híbrido</span>
        </div>
      </div>

      <!-- Right Column: Interactive Live Code Editor (IDE) -->
      <div class="lg:col-span-6 w-full">
        <div class="relative group">
          <!-- Background Glow Effect behind Terminal -->
          <div class="absolute -inset-1.5 bg-gradient-to-r from-cyan-500/30 via-indigo-500/30 to-emerald-500/30 rounded-3xl blur-2xl opacity-60 group-hover:opacity-90 transition duration-500"></div>

          <!-- Code Window Container -->
          <div class="relative rounded-2xl bg-[#0b101b] border border-white/10 shadow-2xl overflow-hidden">
            
            <!-- Window Title Bar -->
            <div class="flex items-center justify-between px-4 py-3 bg-[#0d1424] border-b border-white/5 select-none">
              <!-- Window Dots -->
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
              </div>

              <!-- Active File Tab -->
              <div class="flex items-center gap-2 px-3 py-1 rounded-md bg-[#131c33] border border-white/5 text-xs text-slate-300 font-mono-code">
                <span class="text-cyan-400 font-bold">TS</span>
                <span>bryan_martinez.ts</span>
                <span class="text-slate-500 text-[10px] ml-1">●</span>
              </div>

              <!-- Action Controls -->
              <div class="flex items-center gap-2">
                <button
                  id="replay-code-btn"
                  title="Reiniciar escritura"
                  class="text-xs text-slate-400 hover:text-cyan-400 p-1 rounded hover:bg-white/5 transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                </button>
                <button
                  id="copy-code-btn"
                  title="Copiar código"
                  class="text-xs text-slate-400 hover:text-cyan-400 p-1 rounded hover:bg-white/5 transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Code Editor Body with Line Numbers -->
            <div class="p-4 sm:p-6 font-mono-code text-xs sm:text-sm leading-relaxed overflow-x-auto min-h-[380px] bg-[#070b14]/90">
              <pre id="code-content" class="text-slate-300 font-mono-code whitespace-pre"><code id="code-display"></code><span id="code-cursor" class="inline-block w-2.5 h-4 bg-cyan-400 ml-0.5 translate-y-0.5 animate-cursor-blink"></span></pre>
            </div>

            <!-- Editor Status Footer -->
            <div class="px-4 py-2 bg-[#090e1c] border-t border-white/5 flex items-center justify-between text-[11px] text-slate-400 font-mono-code">
              <div class="flex items-center gap-3">
                <span class="flex items-center gap-1 text-emerald-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  <span>TypeScript 5.0</span>
                </span>
                <span class="hidden sm:inline">UTF-8</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-cyan-400 font-medium">Bryan Martinez · Portfolio</span>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Typewriter Script -->
<script>
  // Code payload to type out in real-time
  const linesToType = [
    { text: '// Perfil de Desarrollador', type: 'comment' },
    { text: 'interface FullStackEngineer {', type: 'interface' },
    { text: '  nombre: string;', type: 'prop' },
    { text: '  titulo: string;', type: 'prop' },
    { text: '  rol: string;', type: 'prop' },
    { text: '  disponible: boolean;', type: 'prop' },
    { text: '  stack: string[];', type: 'prop' },
    { text: '}', type: 'bracket' },
    { text: '', type: 'empty' },
    { text: 'const developer: FullStackEngineer = {', type: 'decl' },
    { text: '  nombre: "Bryan Martinez",', type: 'name' },
    { text: '  titulo: "Ingeniero en Sistemas",', type: 'title' },
    { text: '  rol: "FullStack Developer",', type: 'role' },
    { text: '  disponible: true,', type: 'bool' },
    { text: '  stack: ["React", "Astro", "Tailwind", "Node.js", "Laravel", "PostgreSQL"],', type: 'stack' },
    { text: '  vision: "Construir software escalable y de alto impacto"', type: 'string' },
    { text: '};', type: 'bracket' },
    { text: '', type: 'empty' },
    { text: '// Estado: Listo para compilar y desplegar 🚀', type: 'comment' },
    { text: 'console.log("¡Bienvenido a mi portafolio!");', type: 'log' }
  ];

  function formatLineHtml(lineObj: { text: string; type: string }) {
    const { text, type } = lineObj;
    if (type === 'empty') return '\n';
    if (type === 'comment') return `<span class="text-slate-500 italic">${escapeHtml(text)}</span>\n`;
    if (type === 'interface') return `<span class="text-purple-400 font-bold">interface</span> <span class="text-amber-300 font-semibold">FullStackEngineer</span> <span class="text-slate-300">{</span>\n`;
    if (type === 'prop') {
      const parts = text.split(':');
      return `  <span class="text-sky-300">${escapeHtml(parts[0].trim())}</span>: <span class="text-amber-400">${escapeHtml(parts[1].trim())}</span>\n`;
    }
    if (type === 'bracket') return `<span class="text-slate-300">${escapeHtml(text)}</span>\n`;
    if (type === 'decl') return `<span class="text-purple-400 font-bold">const</span> <span class="text-cyan-300">developer</span>: <span class="text-amber-300">FullStackEngineer</span> = <span class="text-slate-300">{</span>\n`;
    if (type === 'name') return `  <span class="text-sky-300">nombre</span>: <span class="text-emerald-300 font-semibold font-bold">"Bryan Martinez"</span>,\n`;
    if (type === 'title') return `  <span class="text-sky-300">titulo</span>: <span class="text-emerald-300 font-semibold">"Ingeniero en Sistemas"</span>,\n`;
    if (type === 'role') return `  <span class="text-sky-300">rol</span>: <span class="text-emerald-300 font-semibold">"FullStack Developer"</span>,\n`;
    if (type === 'bool') return `  <span class="text-sky-300">disponible</span>: <span class="text-indigo-400 font-bold">true</span>,\n`;
    if (type === 'stack') {
      return `  <span class="text-sky-300">stack</span>: [<span class="text-emerald-300">"React"</span>, <span class="text-emerald-300">"Astro"</span>, <span class="text-emerald-300">"Tailwind"</span>, <span class="text-emerald-300">"Node.js"</span>, <span class="text-emerald-300">"Laravel"</span>, <span class="text-emerald-300">"PostgreSQL"</span>],\n`;
    }
    if (type === 'string') return `  <span class="text-sky-300">vision</span>: <span class="text-emerald-300">"Construir software escalable y de alto impacto"</span>\n`;
    if (type === 'log') return `<span class="text-cyan-400">console</span>.<span class="text-amber-400">log</span>(<span class="text-emerald-300">"¡Bienvenido a mi portafolio!"</span>);\n`;
    return `${escapeHtml(text)}\n`;
  }

  function escapeHtml(str: string) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  const codeDisplay = document.getElementById('code-display');
  const replayBtn = document.getElementById('replay-code-btn');
  const copyBtn = document.getElementById('copy-code-btn');

  let animationTimeout: number | undefined;

  function runTypingAnimation() {
    if (!codeDisplay) return;
    codeDisplay.innerHTML = '';
    
    let currentLineIndex = 0;
    let currentCharIndex = 0;
    let currentLineRender = '';

    function typeNextChar() {
      if (currentLineIndex >= linesToType.length) return;

      const currentItem = linesToType[currentLineIndex];
      const rawText = currentItem.text;

      if (currentItem.type === 'empty') {
        codeDisplay!.innerHTML += '\n';
        currentLineIndex++;
        currentCharIndex = 0;
        animationTimeout = window.setTimeout(typeNextChar, 100);
        return;
      }

      if (currentCharIndex < rawText.length) {
        currentCharIndex++;
        // Partial typing representation
        const typedSlice = rawText.slice(0, currentCharIndex);
        
        // Re-render lines up to currentLineIndex - 1 formatted, then append typed text
        let renderedLines = '';
        for (let i = 0; i < currentLineIndex; i++) {
          renderedLines += formatLineHtml(linesToType[i]);
        }
        
        // Format current line in progress
        renderedLines += escapeHtml(typedSlice);
        codeDisplay!.innerHTML = renderedLines;

        // Speed: faster for code, slightly paused on punctuation
        let delay = 22;
        if (rawText[currentCharIndex - 1] === ',' || rawText[currentCharIndex - 1] === ':') {
          delay = 80;
        }
        animationTimeout = window.setTimeout(typeNextChar, delay);
      } else {
        // Line completed, format it nicely with colors
        currentLineIndex++;
        currentCharIndex = 0;
        let renderedLines = '';
        for (let i = 0; i < currentLineIndex; i++) {
          renderedLines += formatLineHtml(linesToType[i]);
        }
        codeDisplay!.innerHTML = renderedLines;
        animationTimeout = window.setTimeout(typeNextChar, 70);
      }
    }

    typeNextChar();
  }

  // Initialize
  runTypingAnimation();

  if (replayBtn) {
    replayBtn.addEventListener('click', () => {
      if (animationTimeout) clearTimeout(animationTimeout);
      runTypingAnimation();
    });
  }

  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const rawCode = linesToType.map(l => l.text).join('\n');
      navigator.clipboard.writeText(rawCode).then(() => {
        const originalHtml = copyBtn.innerHTML;
        copyBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>`;
        setTimeout(() => {
          copyBtn.innerHTML = originalHtml;
        }, 2000);
      });
    });
  }
</script>
