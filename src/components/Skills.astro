---
// Skills.astro - Categorized technical stack and infinite marquee ribbon
const skillCategories = [
  {
    title: 'Frontend & UI',
    icon: '💻',
    color: 'from-cyan-500/20 to-blue-500/10',
    borderColor: 'hover:border-cyan-500/40',
    skills: [
      { name: 'React.js', level: 'Avanzado', tag: 'UI Library' },
      { name: 'Astro', level: 'Avanzado', tag: 'Fast Web Framework' },
      { name: 'Tailwind CSS', level: 'Avanzado', tag: 'Utility First' },
      { name: 'JavaScript (ES6+)', level: 'Avanzado', tag: 'Core Language' },
      { name: 'TypeScript', level: 'Intermedio-Avanzado', tag: 'Typed JS' },
      { name: 'HTML5 & CSS3', level: 'Dominio Total', tag: 'Web Semantics' },
      { name: 'Vite', level: 'Avanzado', tag: 'Build Tool' },
    ]
  },
  {
    title: 'Backend & APIs',
    icon: '⚙️',
    color: 'from-indigo-500/20 to-purple-500/10',
    borderColor: 'hover:border-indigo-500/40',
    skills: [
      { name: 'Node.js', level: 'Avanzado', tag: 'Runtime' },
      { name: 'Express.js', level: 'Avanzado', tag: 'API Framework' },
      { name: 'Laravel (PHP)', level: 'Intermedio-Avanzado', tag: 'MVC Framework' },
      { name: 'RESTful APIs', level: 'Avanzado', tag: 'Architecture' },
      { name: 'Autenticación & JWT', level: 'Avanzado', tag: 'Security' },
      { name: 'Arquitectura MVC', level: 'Avanzado', tag: 'Design Pattern' },
    ]
  },
  {
    title: 'Bases de Datos',
    icon: '🗄️',
    color: 'from-emerald-500/20 to-teal-500/10',
    borderColor: 'hover:border-emerald-500/40',
    skills: [
      { name: 'PostgreSQL', level: 'Intermedio-Avanzado', tag: 'Relational DB' },
      { name: 'MongoDB', level: 'Avanzado', tag: 'NoSQL / Document' },
      { name: 'MySQL', level: 'Avanzado', tag: 'Relational DB' },
      { name: 'Mongoose / ORM', level: 'Avanzado', tag: 'Data Modeling' },
    ]
  },
  {
    title: 'Herramientas & Entorno',
    icon: '🛠️',
    color: 'from-amber-500/20 to-rose-500/10',
    borderColor: 'hover:border-amber-500/40',
    skills: [
      { name: 'Git & GitHub', level: 'Avanzado', tag: 'Version Control' },
      { name: 'Linux', level: 'Intermedio', tag: 'OS & Terminal' },
      { name: 'Postman', level: 'Avanzado', tag: 'API Testing' },
      { name: 'Netlify & Vercel', level: 'Avanzado', tag: 'Deployment' },
      { name: 'Docker', level: 'Fundamentos', tag: 'Containers' },
    ]
  }
];

const marqueeTechs = [
  'React', 'Astro', 'TypeScript', 'JavaScript', 'Node.js', 'Express',
  'Laravel', 'Tailwind CSS', 'PostgreSQL', 'MongoDB', 'MySQL', 'Git',
  'Linux', 'Vite', 'Postman', 'HTML5', 'CSS3'
];
---

<section id="habilidades" class="relative py-24 overflow-hidden bg-[#060a12]/60">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-mono-code font-semibold tracking-wider uppercase mb-3">
        &lt;Stack Tecnológico /&gt;
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        Habilidades & <span class="bg-gradient-to-r from-indigo-400 to-cyan-400 bg-clip-text text-transparent">Tecnologías</span>
      </h2>
      <p class="mt-4 text-slate-400 text-base md:text-lg max-w-2xl">
        Conjunto de herramientas y lenguajes que utilizo activamente para dar vida a proyectos completos y escalables.
      </p>
    </div>

    <!-- Infinite Scrolling Marquee Ribbon -->
    <div class="relative w-full overflow-hidden py-4 mb-16 border-y border-white/5 bg-slate-950/40">
      <div class="absolute left-0 top-0 bottom-0 w-16 bg-gradient-to-r from-[#060a12] to-transparent z-10 pointer-events-none"></div>
      <div class="absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-[#060a12] to-transparent z-10 pointer-events-none"></div>
      
      <div class="animate-marquee-infinite flex items-center gap-8">
        {[...marqueeTechs, ...marqueeTechs].map((tech) => (
          <div class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900/60 border border-white/5 text-slate-300 hover:text-cyan-400 hover:border-cyan-500/30 transition-colors whitespace-nowrap group">
            <span class="w-2 h-2 rounded-full bg-cyan-400 group-hover:scale-125 transition-transform"></span>
            <span class="text-sm font-semibold font-mono-code">{tech}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Skills Categorized Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {skillCategories.map((category) => (
        <div class={`glass-panel rounded-2xl p-6 border border-white/5 ${category.borderColor} transition-all duration-300 relative group overflow-hidden`}>
          <!-- Subtle Top Gradient -->
          <div class={`absolute top-0 left-0 right-0 h-1 bg-gradient-to-r ${category.color} opacity-80`}></div>

          <!-- Header -->
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <span class="text-2xl p-2 rounded-xl bg-white/5 border border-white/5 inline-block">
                {category.icon}
              </span>
              <h3 class="text-xl font-bold text-white tracking-wide">
                {category.title}
              </h3>
            </div>
            <span class="text-xs text-slate-400 font-mono-code">
              {category.skills.length} Tecnologías
            </span>
          </div>

          <!-- Skills Badges Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {category.skills.map((skill) => (
              <div class="p-3 rounded-xl bg-slate-900/70 border border-white/5 hover:border-white/20 hover:bg-slate-800/80 transition-all duration-200 flex flex-col justify-between">
                <div class="flex items-center justify-between">
                  <span class="font-semibold text-slate-200 text-sm">{skill.name}</span>
                </div>
                <div class="flex items-center justify-between mt-2 pt-1 border-t border-white/5">
                  <span class="text-[11px] text-slate-400 font-mono-code">{skill.tag}</span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-300 font-medium">
                    {skill.level}
                  </span>
                </div>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
