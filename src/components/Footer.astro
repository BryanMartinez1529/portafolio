---
// Footer.astro - Clean modern footer with navigation and back-to-top button
const currentYear = new Date().getFullYear();
---

<footer class="relative border-t border-white/10 bg-[#05080f] text-slate-400 py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-white/5">
      
      <!-- Brand & Info -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <a href="#inicio" class="flex items-center gap-2 group mb-2">
          <span class="w-8 h-8 rounded-lg bg-gradient-to-tr from-cyan-500 to-indigo-600 flex items-center justify-center font-mono-code font-bold text-white text-xs shadow-md">
            &lt;/&gt;
          </span>
          <span class="font-bold text-lg text-white group-hover:text-cyan-400 transition-colors">
            Bryan Martinez
          </span>
        </a>
        <p class="text-xs text-slate-400 font-mono-code">
          Ingeniero en Sistemas — FullStack Developer
        </p>
      </div>

      <!-- Quick Nav Links -->
      <nav class="flex flex-wrap justify-center gap-6 text-sm font-medium">
        <a href="#inicio" class="hover:text-cyan-400 transition-colors">Inicio</a>
        <a href="#sobre-mi" class="hover:text-cyan-400 transition-colors">Sobre Mí</a>
        <a href="#habilidades" class="hover:text-cyan-400 transition-colors">Habilidades</a>
        <a href="#proyectos" class="hover:text-cyan-400 transition-colors">Proyectos</a>
        <a href="#contacto" class="hover:text-cyan-400 transition-colors">Contacto</a>
      </nav>

      <!-- Back to top button -->
      <a
        href="#inicio"
        class="flex items-center gap-2 px-4 py-2 rounded-full glass-panel border border-white/10 text-xs font-semibold text-slate-300 hover:text-white hover:border-cyan-400 transition-all group"
      >
        <span>Volver arriba</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 group-hover:-translate-y-0.5 transition-transform text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </a>

    </div>

    <!-- Bottom Credits -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 text-center">
      <p>
        © {currentYear} Bryan Martinez. Todos los derechos reservados.
      </p>
      <p class="flex items-center gap-1">
        Construido con <span class="text-cyan-400 font-mono-code">Astro</span> & <span class="text-indigo-400 font-mono-code">Tailwind CSS</span>
      </p>
    </div>

  </div>
</footer>
