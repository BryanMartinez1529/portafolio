---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bryan Martinez | Ingeniero en Sistemas - FullStack Developer",
  description = "Portafolio profesional de Bryan Martinez, Ingeniero en Sistemas y Desarrollador Full Stack especializado en React, Astro, Node.js, Laravel y arquitecturas web de alto rendimiento."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/icon_dev.png" />
    <link rel="apple-touch-icon" href="/img/icon_dev.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080c14" />
    <meta name="author" content="Bryan Martinez" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://bryanmartinez.netlify.app/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/img/foto_personal.jpg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/img/foto_personal.jpg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#080c14] text-slate-100 selection:bg-cyan-500/30 selection:text-cyan-200 antialiased relative overflow-x-hidden min-h-screen">
    <!-- Ambient mesh background glows -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute -top-40 -left-40 w-[600px] h-[600px] bg-cyan-600/10 rounded-full blur-[140px]"></div>
      <div class="absolute top-[35%] -right-40 w-[550px] h-[550px] bg-indigo-600/10 rounded-full blur-[140px]"></div>
      <div class="absolute -bottom-40 left-1/3 w-[600px] h-[600px] bg-emerald-600/10 rounded-full blur-[140px]"></div>
      <div class="absolute inset-0 bg-grid-pattern opacity-40"></div>
    </div>

    <!-- Content slot -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>
