            class="px-5 py-3.5 rounded-xl font-semibold text-slate-300 hover:text-cyan-400 hover:bg-white/5 transition-all duration-300 text-sm md:text-base"
          >
            Hablemos →
          </a>
        </div>

        <!-- Quick Social Proof Links -->
        <div class="flex items-center gap-4 pt-4 border-t border-white/5 w-full">
          <span class="text-xs text-slate-400 font-mono-code">Conectar:</span>
          
          <!-- GitHub -->
          <a
